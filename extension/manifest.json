{
 "manifest_version": 3,
 "name": "Fredver",
 "version": "1.5.0",
 "description": "Fredver: shared inbox for Gmail",
 "permissions": [
  "identity",
  "storage",
  "notifications",
  "alarms"
 ],
 "host_permissions": [
  "https://mail.google.com/*",
  "https://cbi-mail-api-1040388630993.us-west1.run.app/*"
 ],
 "content_scripts": [
  {
   "matches": [
    "https://mail.google.com/*"
   ],
   "js": [
    "content.js"
   ]
  }
 ],
 "background": {
  "service_worker": "background.js"
 },
 "key": "",
 "icons": {
  "16": "icons/icon16.png",
  "32": "icons/icon32.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
 }
}